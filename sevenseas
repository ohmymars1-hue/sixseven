		settingsToken += 1
		local myToken = settingsToken

		if not settingsOpen then
			settingsOpen = true
			Window.SettingsOpen = true

			TweenService:Create(settingsIcon, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Rotation = -25}):Play()

