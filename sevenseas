			local redCenter = RedLine.AbsolutePosition + RedLine.AbsoluteSize / 2
			local screenCenter = viewport / 2
			local offsetX = redCenter.X - screenCenter.X
			local offsetY = redCenter.Y - screenCenter.Y
			local targetPos = UDim2.new(0.5, offsetX, 0.5, offsetY)

			local absPos = GreyLine.AbsolutePosition
			local absSize = GreyLine.AbsoluteSize
			GreyLine.Parent = gui
			GreyLine.Size = UDim2.new(0, absSize.X, 0, absSize.Y)
			GreyLine.Position = UDim2.new(0, absPos.X, 0, absPos.Y)

			TweenService:Create(mainFrame, TweenInfo.new(0.5), {Position = targetPos}):Play()
			TweenService:Create(scale, TweenInfo.new(0.5), {Scale = 0.05}):Play()
			TweenService:Create(GreyLine, TweenInfo.new(0.5), {Position = RedLine.Position}):Play()
		else
			isShrunk = false
			-- Put it back inside the frame at its home spot first so it doesn't jump
			GreyLine.Parent = mainFrame
			GreyLine.Size = UDim2.new(0, 90, 0, 8)
			GreyLine.Position = originalGreyPos

