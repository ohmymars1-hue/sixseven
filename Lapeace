--  STANDALONE REGISTRY
local function registerStandalone(item)
	local frame = item.frame
	if frame then
		local scale = Instance.new("UIScale")
		scale.Parent = frame

		-- grey drag handle on top
		local handle = Instance.new("TextButton")
		handle.Name = "DragHandle"
		handle.Size = UDim2.new(0, 80, 0, 16)
		handle.AnchorPoint = Vector2.new(0.5, 0.5)
		handle.Position = UDim2.new(0.5, 0, 0, 0)
		handle.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
		handle.BorderSizePixel = 0
		handle.Text = ""
		handle.AutoButtonColor = false
		handle.ZIndex = 300
		handle.Parent = frame
		corner(handle, UDim.new(1, 0))
		stroke(handle, 1.5)

		local dragging = false
		local dragStart, startAnchor

		handle.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			local ap, sz = frame.AbsolutePosition, frame.AbsoluteSize
			startAnchor = Vector2.new(ap.X + sz.X * frame.AnchorPoint.X, ap.Y + sz.Y * frame.AnchorPoint.Y)
		end)

		local moveConn, endConn
		moveConn = UserInputService.InputChanged:Connect(function(input)
			if not frame:IsDescendantOf(game) then
				moveConn:Disconnect()
				endConn:Disconnect()
				return
			end
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				local d = Vector2.new(input.Position.X, input.Position.Y) - dragStart
				local p = startAnchor + d
				local vp = workspace.CurrentCamera.ViewportSize
				frame.Position = UDim2.fromOffset(math.clamp(p.X, 0, vp.X), math.clamp(p.Y, 0, vp.Y))
			end
		end)
		endConn = UserInputService.InputEnded:Connect(function(input)
			if dragging and isPress(input) then
				dragging = false
			end
		end)

		function item.applySettings(animate)
			handle.Visible = standaloneSettings.draggable
			if not standaloneSettings.draggable then dragging = false end
			local target = sizeToScale(standaloneSettings.size)
			if animate then
				TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Scale = target}):Play()
			else
				scale.Scale = target
			end
		end
		item.applySettings(false)
	end
	table.insert(standaloneItems, item)
end

