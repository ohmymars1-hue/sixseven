----------------------------------------------------------------------
-- OWNERS
-- Client-side list. It only decides who gets the OWNER rank and the
-- owner-only Window:GetUniversalTab(). It is NOT real security: anyone
-- who runs their own copy of this file can edit it.
----------------------------------------------------------------------
local OWNERS = {
	"SilentWraths", -- 3rd letter is a lowercase L
}

local function isOwner(name)
	name = string.lower(tostring(name))
	for _, o in ipairs(OWNERS) do
		if string.lower(o) == name then
			return true
		end
	end
	return false
end

