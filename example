			noResults.TextColor3 = Color3.fromRGB(120, 120, 120)
			noResults.Visible = false
			noResults.ZIndex = 99
			noResults.LayoutOrder = 999999
			noResults.Parent = scrollFrame

			local function applySearch()
				local q = string.lower(box.Text)
				q = string.match(q, "^%s*(.-)%s*$") or ""
				clear.Visible = box.Text ~= ""

				if q == "" then
					for _, e in ipairs(Tab.Elements) do
						rowOf(e.obj).Visible = true
					end
					noResults.Visible = false
					return
				end

				local anyShown = false
				local sepEntry, sepHasMatch, groupMatches = nil, false, false

				local function closeGroup()
					if sepEntry then
						rowOf(sepEntry.obj).Visible = sepHasMatch
					end
				end

				for _, e in ipairs(Tab.Elements) do
					if e.kind == "sep" then
						closeGroup()
						sepEntry = e
						sepHasMatch = false
						groupMatches = string.find(string.lower(e.text), q, 1, true) ~= nil
					else
						local hit = groupMatches or string.find(string.lower(e.text), q, 1, true) ~= nil
						rowOf(e.obj).Visible = hit
						if hit then
							anyShown = true
							sepHasMatch = true
						end
					end
				end
				closeGroup()

				noResults.Visible = not anyShown
				scrollFrame.CanvasPosition = Vector2.zero
			end

			box:GetPropertyChangedSignal("Text"):Connect(applySearch)
			clear.Activated:Connect(function()
				box.Text = ""
				box:ReleaseFocus()
			end)

			Tab.SearchBar = bar
			return bar
		end

