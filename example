-- UNIVERSAL SECTION CONTENT
-- Edit THIS function to change what the Universal tab contains.
-- Script users can't reach it through the normal API (owner only).
----------------------------------------------------------------------
local function buildUniversal(Tab, Window)
	local player = Players.LocalPlayer
	local RunService = game:GetService("RunService")
	local bag = {}

	local function getRoot()
		local char = player.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	local function getHumanoid()
		local char = player.Character
		return char and char:FindFirstChildOfClass("Humanoid")
	end

	-- (the search bar is created automatically by Window:CreateTab)

	Tab:AddInfo("Hold any element for 1.5s to make a STANDALONE copy of it.")

	-- MOVEMENT ------------------------------------------------------
	Tab:AddSeparator("MOVEMENT")

	local controls, controlsTried
	local function getControls()
		if not controlsTried then
			controlsTried = true
			pcall(function()
				controls = require(player:WaitForChild("PlayerScripts", 3):WaitForChild("PlayerModule", 3)):GetControls()
			end)
		end
		return controls
	end

	local stopWalking = false
	local savedSpeed = 16
	local speedConn

	local function releaseFallback()
		if speedConn then speedConn:Disconnect() speedConn = nil end
		local hum = getHumanoid()
		if hum and hum.WalkSpeed == 0 then
			hum.WalkSpeed = savedSpeed
		end
	end

	local function applyFallback()
		releaseFallback()
		local hum = getHumanoid()
		if not hum then return end
		if hum.WalkSpeed ~= 0 then savedSpeed = hum.WalkSpeed end
		hum.WalkSpeed = 0
		speedConn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if stopWalking and hum.WalkSpeed ~= 0 then
				savedSpeed = hum.WalkSpeed
				hum.WalkSpeed = 0
			end
		end)
	end

	local function setStopWalking(state)
		stopWalking = state
		local c = getControls()
		if c then
			if state then c:Disable() else c:Enable() end
		else
			if state then applyFallback() else releaseFallback() end
		end
	end

	local _, stopApi = Tab:AddToggle("Force Stop Walking", false, setStopWalking)

	local frozenCFrame, freezeConn

	local function setFreeze(state)
		if freezeConn then freezeConn:Disconnect() freezeConn = nil end
		local root = getRoot()
		if state then
			if not root then
				Library:CreateNotification("No character found", 3)
				return
			end
			frozenCFrame = root.CFrame
			freezeConn = RunService.Heartbeat:Connect(function()
				local r = getRoot()
				if not r then return end
				r.Anchored = true
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				r.CFrame = frozenCFrame
			end)
		elseif root then
			root.Anchored = false
		end
	end

	local _, freezeApi = Tab:AddToggle("Freeze Body", false, setFreeze)

	table.insert(bag, player.CharacterAdded:Connect(function()
		if freezeConn then
			freezeConn:Disconnect()
			freezeConn = nil
			task.wait(1)
			setFreeze(true) -- freeze again at the new spawn point
		end
		if stopWalking and not getControls() then
			task.wait(0.5)
			applyFallback()
		end
	end))

	-- TELEPORT ------------------------------------------------------
	Tab:AddSeparator("TELEPORT")

	Tab:AddButton("Copy Coordinates", function()
		local root = getRoot()
		if not root then
			Library:CreateNotification("No character found", 3)
			return
		end

		local p = root.Position
		local text = string.format("%.2f, %.2f, %.2f", p.X, p.Y, p.Z)
		local copy = setclipboard or toclipboard
		if copy then
			copy(text)
			Library:CreateNotification("Copied: " .. text, 3)
		else
			print(text)
			Library:CreateNotification("No clipboard support, printed to console", 4)
		end
	end)

	Tab:AddInput("Teleport To", "x, y, z", function(text)
		local nums = {}
		for n in string.gmatch(text, "-?%d+%.?%d*") do
			table.insert(nums, tonumber(n))
		end

		if #nums < 3 then
			Library:CreateNotification("Invalid format. Use: x, y, z", 3)
			return
		end

		local root = getRoot()
		if not root then
			Library:CreateNotification("No character found", 3)
			return
		end

		root.CFrame = CFrame.new(nums[1], nums[2], nums[3])
		Library:CreateNotification("Teleported!", 2)
	end)

	-- STANDALONES ---------------------------------------------------
	Tab:AddSeparator("STANDALONES")

	Tab:AddButton("Remove All Standalones", function()
		Library.ClearStandalones()
		Library:CreateNotification("Standalones removed", 2)
	end)

	-- never leave the player stuck if the UI is closed with the O button
	Window.Gui.Destroying:Connect(function()
		for _, c in ipairs(bag) do
			pcall(function() c:Disconnect() end)
		end
		pcall(function() stopApi.set(false) end)
		pcall(function() freezeApi.set(false) end)
	end)
end

