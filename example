			numberLabel.BackgroundTransparency = 1
			numberLabel.Text = tostring(default)
			numberLabel.Font = Enum.Font.GothamBold
			numberLabel.TextSize = 16
			numberLabel.TextColor3 = Color3.new(0, 0, 0)
			numberLabel.TextXAlignment = Enum.TextXAlignment.Right
			numberLabel.ClearTextOnFocus = false
			numberLabel.ZIndex = 99
			numberLabel.Parent = firstBox

			local sliderTrack = Instance.new("Frame")
			sliderTrack.Size = UDim2.new(1, -130, 0, 12)
			sliderTrack.Position = UDim2.new(0, 10, 0.5, -6)
			sliderTrack.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
			sliderTrack.BorderSizePixel = 0
			sliderTrack.ZIndex = 99
			sliderTrack.Parent = firstBox
			corner(sliderTrack, UDim.new(1, 0))
			stroke(sliderTrack, 1)

			local range = math.max(max - min, 1)
			local sliderFill = Instance.new("Frame")
			sliderFill.Size = UDim2.new((default - min) / range, 0, 1, 0)
			sliderFill.BackgroundColor3 = Color3.fromRGB(160, 160, 160)
			sliderFill.BorderSizePixel = 0
			sliderFill.ZIndex = 100
			sliderFill.Parent = sliderTrack
			corner(sliderFill, UDim.new(1, 0))

			local dragging = false
			local currentValue = default
			local listeners = {}

			-- one place that changes the value: updates this slider, fires the
			-- callback and mirrors the value to every standalone copy
			local function setValue(v)
				v = math.clamp(math.floor(v + 0.5), min, max)
				currentValue = v
				sliderFill.Size = UDim2.new((v - min) / range, 0, 1, 0)
				numberLabel.Text = tostring(v)
				safe(callback, v)
				for i = #listeners, 1, -1 do
					if not listeners[i](v) then table.remove(listeners, i) end
				end
			end

			local function updateSlider(input)
				local trackPos = sliderTrack.AbsolutePosition.X
				local trackSize = sliderTrack.AbsoluteSize.X
				local percentage = math.clamp((input.Position.X - trackPos) / trackSize, 0, 1)
				setValue(min + (max - min) * percentage)
			end

			sliderTrack.InputBegan:Connect(function(input)
				if isPress(input) then
					dragging = true
					scrollFrame.ScrollingEnabled = false -- don't scroll the tab while dragging
					updateSlider(input)
				end
			end)

			track(UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					updateSlider(input)
				end
			end))

			track(UserInputService.InputEnded:Connect(function(input)
				if isPress(input) then
					dragging = false
					scrollFrame.ScrollingEnabled = true
				end
			end))

			numberLabel.FocusLost:Connect(function()
				local inputValue = tonumber(numberLabel.Text)
				if inputValue then
					setValue(inputValue) -- rounds + clamps like dragging does
				else
					numberLabel.Text = tostring(currentValue)
				end
			end)

			local hold = makeHold(Window, sliderContainer, sliderContainer, {
				name = text,
				spawn = function(pos)
					local item
					item = Library.CreateSlider({
						label = text, min = min, max = max, default = currentValue, position = pos,
						callback = function(v) setValue(v) end -- copy -> original (+ other copies)
					})
					table.insert(listeners, function(v) -- original -> copy
						if not item.frame:IsDescendantOf(game) then return false end
						item.setValue(v, true)
						return true
					end)
					return item
				end
			})
			hold.bind(sliderContainer)
			hold.bind(sliderTrack)

			return register(sliderContainer, text)
		end

		function Tab:AddSeparator(text)
