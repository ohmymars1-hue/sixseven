function Library.CreateButton(config)
	config = config or {}
	local label = config.label or "Button"
	local position = config.position or UDim2.new(0.5, 0, 0.1, 0)
	local callback = config.callback

	local gui = createScreenGui("ButtonGui")

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 200, 0, 50)
	button.Position = position
	button.AnchorPoint = Vector2.new(0.5, 0)
	button.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = label
	button.Font = Enum.Font.GothamBold
	button.TextSize = 18
	button.TextColor3 = Color3.new(0, 0, 0)
	button.Parent = gui
	corner(button, UDim.new(0, 12))
	stroke(button, 2)

	local function fire()
		safe(callback)
	end
	button.Activated:Connect(function()
		if DragState.guard() then return end
		fire()
	end)

	return {
		frame = button,
		click = fire,
		setText = function(t) button.Text = t end,
		destroy = function() gui:Destroy() end
	}
end

